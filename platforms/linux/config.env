# Linux settings, read by run.sh. One KEY=VALUE per line; lines starting with # are comments.
# A variable already set in your environment overrides the value here.

# Where the shared local model runs:
#   auto    = NVIDIA GPU container if Docker has the nvidia runtime (NVIDIA Container Toolkit), otherwise CPU container
#   nvidia  = force the NVIDIA GPU container
#   cpu     = force a CPU-only container
#   host    = bridge to an Ollama installed on this machine. NOTE: that Ollama must listen beyond 127.0.0.1
#             (OLLAMA_HOST=0.0.0.0), which exposes it to your LAN unless firewalled. Prefer the container modes.
OLLAMA_MODE=auto

# Parallel requests the model server handles. 1 keeps a 14B model fully in a 16 GB GPU.
OLLAMA_NUM_PARALLEL=1

# Port for the control panel web page (always bound to 127.0.0.1).
PANEL_PORT=8765
