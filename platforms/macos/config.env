# macOS settings, read by run.sh. One KEY=VALUE per line; lines starting with # are comments.
# A variable already set in your environment overrides the value here.

# Where the shared local model runs:
#   host    = use the Ollama installed on this Mac (uses the Mac GPU via Metal). RECOMMENDED on macOS:
#             Docker on a Mac cannot access the GPU, so a container would be CPU-only and slow.
#   cpu     = run Ollama in a CPU-only container (slow; nothing to install besides Docker)
#   auto    = same as host on a Mac
OLLAMA_MODE=host

# Parallel requests the model server handles (used by the container modes).
OLLAMA_NUM_PARALLEL=1

# Port for the control panel web page (always bound to 127.0.0.1).
PANEL_PORT=8765
